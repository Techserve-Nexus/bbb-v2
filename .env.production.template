# .env - Production Environment Variables Template
# ⚠️ NEVER COMMIT THIS FILE TO GIT ⚠️
# Copy to .env.local and fill in your actual values

# ============================================
# DATABASE CONFIGURATION (REQUIRED)
# ============================================
# Production: Use MongoDB Atlas or managed MongoDB
# Development: Can use localhost
DATABASE_URL=mongodb+srv://username:password@cluster.mongodb.net/database?retryWrites=true&w=majority

# ============================================
# APPLICATION CONFIGURATION (REQUIRED)
# ============================================
# Your production domain (required for emails, QR codes, payment callbacks)
NEXT_PUBLIC_APP_URL=https://yourdomain.com

# Optional: For development/testing
# NEXT_PUBLIC_BASE_URL=https://yourdomain.com

# ============================================
# SMTP EMAIL CONFIGURATION (REQUIRED)
# ============================================
# Gmail (recommended for small scale):
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM=Your Event Name<your-email@gmail.com>
SMTP_FROM_NAME=Your Event Name
SMTP_REPLY_TO=your-email@gmail.com

# Alternative: SendGrid (recommended for production)
# SENDGRID_API_KEY=your-sendgrid-api-key
# SENDGRID_FROM_EMAIL=noreply@yourdomain.com
# SENDGRID_FROM_NAME=Your Event Name
# SENDGRID_REPLY_TO=support@yourdomain.com
# EMAIL_SERVICE=sendgrid

# ============================================
# CLOUDINARY CONFIGURATION (REQUIRED)
# ============================================
# For image uploads (banners, sponsors, etc.)
# Get from: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your-upload-preset

# ============================================
# ADMIN CREDENTIALS (REQUIRED)
# ============================================
# ⚠️ IMPORTANT: Use strong passwords in production
# Generate strong password: openssl rand -base64 32
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=your-very-strong-password-here

# ============================================
# PAYMENT GATEWAY CONFIGURATION (REQUIRED)
# ============================================
# Replace with your actual payment gateway credentials
PG_API_KEY=your-payment-gateway-api-key
PG_SALT=your-payment-gateway-salt
PG_API_URL=https://your-payment-gateway.com
PG_ENCRYPTION_KEY=your-encryption-key
PG_DECRYPTION_KEY=your-decryption-key

# Public keys (safe to expose in client-side code)
NEXT_PUBLIC_PG_API_KEY=your-payment-gateway-api-key
NEXT_PUBLIC_PG_RETURN_URL=https://yourdomain.com/payment-status
NEXT_PUBLIC_PG_URL=https://your-payment-gateway.com/v2/paymentrequest

# ============================================
# OPTIONAL: RAZORPAY (If using Razorpay instead)
# ============================================
# RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxx
# RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

# ============================================
# MONITORING & ANALYTICS (OPTIONAL)
# ============================================
# SENTRY_DSN=your-sentry-dsn
# NEXT_PUBLIC_GA_ID=your-google-analytics-id

# ============================================
# PRODUCTION ENVIRONMENT (REQUIRED)
# ============================================
NODE_ENV=production
