# ============================
# NEXT.JS PRODUCTION .npmrc
# ============================

# ------- pnpm SETTINGS -------

# Use pnpm as the package manager
package-manager=pnpm

# Use a shared global pnpm store
store-dir=~/.pnpm-store

# Lock down dependency versions (no ^ or ~)
save-exact=true

# Faster, deterministic installs
frozen-lockfile=true

# Strict mode – prevents hidden hoisting issues
strict-peer-dependencies=false

# Install missing peer deps automatically
auto-install-peers=true

# Avoid downloading unnecessary files
prefer-offline=true

# Clean and deterministic node_modules
node-linker=hoisted

# Disable prompts for native builds (Next.js uses sharp)
pnpm.allowedBuiltDependencies=sharp,core-js

# Uncomment to allow ALL builds (less secure)
# pnpm.allowedBuiltDependencies=*


# ------- NPM GENERAL SETTINGS -------

# Use npmjs registry
registry=https://registry.npmjs.org/

# Don't generate package-lock.json
package-lock=false

# Make installs faster and smaller
fund=false
audit=false
